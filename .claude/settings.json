{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push origin main:*)",
      "Bash(git push upstream main:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
